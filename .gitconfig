[user]
	name = Will Dalgleish
	email = will@wdalgleish.com
	signingkey = ~/.ssh/id_rsa.pub
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[column]
	ui = auto
[branch]
	sort = -committerdate
[gpg]
	format = ssh
	repo = /home/will/dotfiles
[safe]
	directory = /home/will/projects/charlie-will-software/sync-cli
	directory = /home/will/projects/charlie-will-software/sync-cli

[alias]
	co = commit
	com = commit -sm
	ch = checkout
	sw = switch
	logo = log --oneline
	br = branch
	st = status
